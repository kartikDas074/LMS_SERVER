{
  "kind": "collectionType",
  "collectionName": "lessons",
  "info": {
    "singularName": "lesson",
    "pluralName": "lessons",
    "displayName": "Lesson"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "courseId": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::course.course"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "lessonNo": {
      "type": "uid",
      "targetField": "title",
      "required": true,
      "unique": true
    },
    "lessonOrder": {
      "type": "integer",
      "required": true,
      "min": 1
    },
    "videourl": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "duration": {
      "type": "integer",
      "required": true,
      "min": 1
    }
  }
}
